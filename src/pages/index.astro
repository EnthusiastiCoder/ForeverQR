---
import Base from '../layouts/Base.astro';
import StudioApp from '../components/studio/StudioApp.svelte';
---

<Base title="ForeverQR: free QR codes that never expire">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold sm:text-4xl">QR codes that never expire</h1>
      <p class="mt-2 text-lg">Free. No signup. Made entirely in your browser.</p>
    </header>
    <StudioApp client:load />
  </div>
</Base>
