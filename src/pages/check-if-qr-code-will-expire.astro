---
import Base from '../layouts/Base.astro';
import Checker from '../components/checker/Checker.svelte';
---

<Base
  title="Will this QR code expire? Free checker | ForeverQR"
  description="Scan or upload any QR code to see if it is dynamic, goes through a short link, or points straight at a page. Checked in your browser."
>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <header class="mb-6">
      <h1 class="text-3xl font-bold sm:text-4xl">Will this QR code expire?</h1>
      <p class="mt-2 text-lg">Check any QR code. Nothing leaves your device.</p>
    </header>
    <Checker client:load />
  </div>
</Base>
