---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | ForeverQR" description="That page does not exist. Go back to the QR code studio.">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold sm:text-4xl">Page not found</h1>
    <p class="mt-3 text-lg">There is nothing at this address.</p>
    <p class="mt-6">
      <a href="/" class="fq-btn fq-btn-primary">Open the QR code studio</a>
    </p>
  </div>
</Base>
