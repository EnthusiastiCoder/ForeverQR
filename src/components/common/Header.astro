---
import ThemeToggle from './ThemeToggle.svelte';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Studio' },
  { href: '/check-if-qr-code-will-expire/', label: 'Will it die?' },
  { href: '/about/', label: 'About' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-30 border-b border-line bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/70">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6">
    <a href="/" class="mr-auto flex items-center gap-2.5 rounded-lg font-bold text-ink" aria-label="ForeverQR home">
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
        <rect width="32" height="32" rx="8" class="fill-brand"></rect>
        <path
          d="M7 7h7v7H7zM18 7h7v7h-7zM7 18h7v7H7z"
          fill="none"
          stroke-width="2.4"
          class="stroke-on-brand"></path>
        <path d="M18 18h3v3h-3zM22 22h3v3h-3zM22 18h3v3h-3zM18 22h3v3h-3z" class="fill-on-brand"></path>
      </svg>
      <span class="text-lg tracking-tight">Forever<span class="text-brand">QR</span></span>
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-1 text-sm font-medium">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isCurrent(l.href) ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-2.5 py-2 whitespace-nowrap transition-colors hover:bg-surface-2 sm:px-3',
                  isCurrent(l.href) ? 'text-brand' : 'text-ink',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle client:load />
  </div>
</header>
